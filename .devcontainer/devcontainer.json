{
  "name": "Oremi Isinmi Agent",
  "dockerComposeFile": "workspace.yaml",
  "service": "devcontainer",
  "runServices": [
    "ollama"
  ],
  "workspaceFolder": "/workspaces",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "make install",
  "forwardPorts": [
    7337
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.pylint",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "GitHub.copilot",
        "Continue.continue"
      ]
    }
  }
}